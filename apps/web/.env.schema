# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Clave de ElevenLabs para la entrevista por voz. Se queda en el servidor.
# @optional
ELEVENLABS_API_KEY=

# ID del agente de voz. No es secreto: viaja en el link de cada llamada, por eso va @public
# (si no, varlock bloquea la respuesta de /api/voz creyendo que se filtra).
# @public @optional
ELEVENLABS_AGENT_ID=

# Contraseña del panel interno /costos (el usuario puede ser cualquiera). La elige Eze.
# @optional
COSTOS_CLAVE=

# Supabase (proyecto brandia): la base del registro de pagos del panel /costos.
# La dirección del proyecto no es secreta.
# @public @optional
SUPABASE_URL=

# Clave de servicio de Supabase: solo la usa el servidor. Nunca va a la pantalla ni al repo.
# @optional
SUPABASE_SERVICE_ROLE_KEY=
